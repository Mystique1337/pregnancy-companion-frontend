# Copy to .env.local and fill in. NEVER commit .env.local.

# --- AI: NVIDIA NIM (OpenAI-compatible). Swap base URL/key/model for any OpenAI-compatible provider. ---
NVIDIA_API_KEY=nvapi-xxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# --- Database: direct Postgres connection (Supabase/Railway). App uses a dedicated schema. ---
SUPABASE_DB_URL=postgresql://user:password@host:port/postgres
DB_SCHEMA=preg_companion

# --- App auth / session ---
AUTH_SECRET=run: openssl rand -hex 32
APP_URL=http://localhost:3000

# --- Admin panel ---
ADMIN_PASSWORD=choose-a-strong-admin-password

# --- Weekly delivery (all optional; blank = skip that channel) ---
CRON_SECRET=run: openssl rand -hex 16

# Email via Resend (resend.com). Blank RESEND_API_KEY = email is skipped cleanly.
# Use onboarding@resend.dev until you verify a domain (it only delivers to the
# Resend account owner's address). Then switch EMAIL_FROM to your verified domain.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Bumply <onboarding@resend.dev>
# Gmail SMTP alternative (if set, used instead of Resend). Needs a Google App Password (16 chars, 2FA on).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# WhatsApp via Evolution API (self-hosted, v2). Blank URL/key = WhatsApp skipped.
EVOLUTION_API_URL=https://your-evolution-host
EVOLUTION_API_KEY=your-evolution-global-api-key
EVOLUTION_INSTANCE=bumply
# EVOLUTION_API_VERSION=v2          # set to v1 only for old Evolution servers
WHATSAPP_WEBHOOK_SECRET=run: openssl rand -hex 16
# Two-way chat: Evolution must be able to REACH your app's webhook.
# In local dev expose the app with a tunnel (e.g. ngrok) and set this to that URL:
# PUBLIC_WEBHOOK_URL=https://your-public-tunnel
# WHATSAPP_CHAT_REQUIRES_PREMIUM=false   # true = free users get an upsell instead of chat

# Telegram bot (reliable two-way chat). Create a bot via @BotFather → token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=run: openssl rand -hex 16

# --- Web push notifications. Generate with: npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@thebrandnerve.com

# --- RAG: NVIDIA embeddings (uses NVIDIA_API_KEY) + Meilisearch keyword index ---
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
MEILI_URL=https://your-meili-host
MEILI_KEY=your-meili-master-key
MEILI_INDEX=kb

# --- Voice: Modal SoroTTS (TTS) + Whisper (ASR). MODAL_API_KEY only if endpoints require auth. ---
MODAL_TTS_URL=https://your-tts-host.modal.run
MODAL_ASR_URL=https://your-asr-host.modal.run
MODAL_API_KEY=

# --- Hugging Face (optional; NLLB translation for the KB). Needs a supported model/endpoint. ---
HF_TOKEN=
# HF_TRANSLATE_MODEL=facebook/nllb-200-distilled-600M
# HF_TRANSLATE_URL=https://your-dedicated-inference-endpoint   # if NLLB isn't on serverless

# Optional: while on Resend shared sender, route every email to this one inbox
EMAIL_OVERRIDE_TO=
